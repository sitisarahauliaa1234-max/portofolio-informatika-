
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portofolio Interaktif | Creative Developer</title>
  
  <!-- Font Google (Poppins) & FontAwesome for Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    /* ==========================================
       1. VARIABLES & BASE STYLES
       ========================================== */
    :root {
      --bg-color: #0d0d0d;
      --card-bg: #161616;
      --primary-red: #ff2a2a;
      --hover-red: #ff5252;
      --text-main: #ffffff;
      --text-muted: #a0a0a0;
      --glow-red: rgba(255, 42, 42, 0.4);
      --font-family: 'Poppins', sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-family);
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* Scrollbar Styling */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: var(--bg-color);
    }
    ::-webkit-scrollbar-thumb {
      background: var(--primary-red);
      border-radius: 4px;
    }

    /* ==========================================
       2. NAVIGATION BAR
       ========================================== */
    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(13, 13, 13, 0.85);
      backdrop-filter: blur(10px);
      z-index: 1000;
      border-bottom: 1px solid rgba(255, 42, 42, 0.1);
    }

    .logo {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-main);
      text-decoration: none;
      letter-spacing: 1px;
    }

    .logo span {
      color: var(--primary-red);
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 30px;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-weight: 500;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: var(--primary-red);
      text-shadow: 0 0 8px var(--glow-red);
    }

    /* ==========================================
       3. REUSABLE COMPONENTS & ANIMATIONS
       ========================================== */
    section {
      padding: 100px 8% 60px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .section-title {
      font-size: 2.2rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 50px;
      position: relative;
    }

    .section-title span {
      color: var(--primary-red);
    }

    .btn {
      display: inline-block;
      padding: 12px 30px;
      background: var(--primary-red);
      color: #fff;
      font-weight: 600;
      border-radius: 30px;
      text-decoration: none;
      border: 2px solid var(--primary-red);
      box-shadow: 0 0 15px var(--glow-red);
      transition: 0.3s ease;
      cursor: pointer;
    }

    .btn:hover {
      background: transparent;
      color: var(--primary-red);
      transform: translateY(-3px);
      box-shadow: 0 0 25px var(--glow-red);
    }

    /* Scroll Reveal Animation Classes */
    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: all 0.8s ease;
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================
       4. HERO SECTION (Level 1)
       ========================================== */
    #hero {
      align-items: center;
      text-align: center;
      background: radial-gradient(circle at center, rgba(255, 42, 42, 0.15) 0%, rgba(13, 13, 13, 1) 70%);
    }

    .hero-badge {
      padding: 6px 16px;
      background: rgba(255, 42, 42, 0.1);
      border: 1px solid var(--primary-red);
      color: var(--primary-red);
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .hero-title {
      font-size: 3.5rem;
      font-weight: 700;
      margin-bottom: 15px;
    }

    .hero-subtitle {
      font-size: 1.2rem;
      color: var(--text-muted);
      max-width: 600px;
      margin-bottom: 30px;
    }

    /* ==========================================
       5. JOURNEY / TIMELINE (Level 2)
       ========================================== */
    .timeline {
      position: relative;
      max-width: 800px;
      margin: 0 auto;
    }

    .timeline::after {
      content: '';
      position: absolute;
      width: 2px;
      background: var(--primary-red);
      top: 0;
      bottom: 0;
      left: 50%;
      margin-left: -1px;
      box-shadow: 0 0 10px var(--glow-red);
    }

    .timeline-item {
      padding: 10px 40px;
      position: relative;
      width: 50%;
    }

    .timeline-item::after {
      content: '';
      position: absolute;
      width: 16px;
      height: 16px;
      right: -8px;
      background-color: var(--bg-color);
      border: 3px solid var(--primary-red);
      top: 15px;
      border-radius: 50%;
      z-index: 1;
    }

    .left { left: 0; text-align: right; }
    .right { left: 50%; text-align: left; }
    .right::after { left: -8px; }

    .timeline-content {
      padding: 20px;
      background: var(--card-bg);
      border-radius: 8px;
      border-left: 3px solid var(--primary-red);
    }

    .timeline-date {
      color: var(--primary-red);
      font-weight: 600;
      font-size: 0.85rem;
    }

    /* ==========================================
       6. SKILL TREE / INVENTORY (Level 3)
       ========================================== */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      max-width: 1000px;
      margin: 0 auto;
      width: 100%;
    }

    .skill-card {
      background: var(--card-bg);
      padding: 25px;
      border-radius: 10px;
      border: 1px solid #222;
      transition: 0.3s;
      text-align: center;
    }

    .skill-card:hover {
      border-color: var(--primary-red);
      transform: translateY(-5px);
      box-shadow: 0 5px 20px rgba(255, 42, 42, 0.2);
    }

    .skill-card i {
      font-size: 2.5rem;
      color: var(--primary-red);
      margin-bottom: 15px;
    }

    /* ==========================================
       7. PROJECT SHOWCASE (Level 4)
       ========================================== */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
    }

    .project-card {
      background: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #222;
      transition: 0.3s;
    }

    .project-card:hover {
      border-color: var(--primary-red);
      transform: translateY(-8px);
    }

    .project-img {
      width: 100%;
      height: 180px;
      background: #222;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 3rem;
    }

    .project-info {
      padding: 20px;
    }

    .project-title {
      font-size: 1.2rem;
      margin-bottom: 10px;
    }

    .project-desc {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 15px;
    }

    .project-tags {
      display: flex;
      gap: 8px;
      margin-bottom: 15px;
      flex-wrap: wrap;
    }

    .tag {
      font-size: 0.75rem;
      background: rgba(255, 42, 42, 0.1);
      color: var(--primary-red);
      padding: 4px 10px;
      border-radius: 4px;
    }

    /* ==========================================
       8. CONTACT SECTION (Level 5)
       ========================================== */
    .contact-container {
      max-width: 600px;
      margin: 0 auto;
      width: 100%;
      background: var(--card-bg);
      padding: 40px;
      border-radius: 12px;
      border: 1px solid #222;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 12px;
      background: #0d0d0d;
      border: 1px solid #333;
      border-radius: 6px;
      color: #fff;
      font-family: inherit;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--primary-red);
    }

    /* ==========================================
       9. RESPONSIVE DESIGN
       ========================================== */
    @media (max-width: 768px) {
      .hero-title { font-size: 2.3rem; }
      .timeline::after { left: 31px; }
      .timeline-item { width: 100%; padding-left: 70px; padding-right: 25px; }
      .timeline-item.right { left: 0%; }
      .left { text-align: left; }
      .timeline-item::after { left: 23px; }
      .nav-links { display: none; } /* Simpelasi untuk mobile view */
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <header>
    <a href="#" class="logo">PORT<span>FOLIO</span></a>
    <ul class="nav-links">
      <li><a href="#hero">Start</a></li>
      <li><a href="#journey">Journey</a></li>
      <li><a href="#skills">Skills</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </header>

  <!-- SECTION 1: HERO -->
  <section id="hero">
    <div class="hero-badge"><i class="fa-solid fa-gamepad"></i> Level 1: Welcome</div>
    <h1 class="hero-title">Halo, Saya <span style="color: var(--primary-red);">Alex</span></h1>
    <p class="hero-subtitle">Creative Web Developer & UI/UX Designer. Saya membangun pengalaman digital yang menarik, interaktif, dan berkinerja tinggi.</p>
    <a href="#journey" class="btn"><i class="fa-solid fa-play"></i> Mulai Petualangan</a>
  </section>

  <!-- SECTION 2: JOURNEY / TIMELINE -->
  <section id="journey">
    <h2 class="section-title reveal">Alur <span>Perjalanan</span></h2>
    <div class="timeline">
      <div class="timeline-item left reveal">
        <div class="timeline-content">
          <span class="timeline-date">2021 - Mulai Misi</span>
          <h3>Langkah Pertama</h3>
          <p>Mempelajari dasar-dasar pemrograman web (HTML, CSS, JS) dan menyelesaikan proyek sederhana pertamaku.</p>
        </div>
      </div>
      <div class="timeline-item right reveal">
        <div class="timeline-content">
          <span class="timeline-date">2023 - Peningkatan Level</span>
          <h3>Frontend Specialist</h3>
          <p>Menguasai framework modern seperti React dan Tailwind CSS untuk membuat antarmuka yang cepat dan responsif.</p>
        </div>
      </div>
      <div class="timeline-item left reveal">
        <div class="timeline-content">
          <span class="timeline-date">2025 - Mode Profesi</span>
          <h3>Fullstack & Creative Developer</h3>
          <p>Bekerja dalam berbagai proyek klien, memadukan estetika UI/UX dengan fungsionalitas backend.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: SKILL TREE -->
  <section id="skills">
    <h2 class="section-title reveal">Skill <span>Tree</span></h2>
    <div class="skills-grid">
      <div class="skill-card reveal">
        <i class="fa-brands fa-html5"></i>
        <h3>Frontend Dev</h3>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 5px;">HTML5, CSS3, JavaScript ES6+, React</p>
      </div>
      <div class="skill-card reveal">
        <i class="fa-solid fa-paintbrush"></i>
        <h3>UI/UX Design</h3>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 5px;">Figma, Wireframing, Prototyping</p>
      </div>
      <div class="skill-card reveal">
        <i class="fa-solid fa-server"></i>
        <h3>Backend Dev</h3>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 5px;">Node.js, Express, REST APIs, MongoDB</p>
      </div>
      <div class="skill-card reveal">
        <i class="fa-solid fa-fire"></i>
        <h3>Tools & Vcs</h3>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 5px;">Git, GitHub, VS Code, Vercel</p>
      </div>
    </div>
  </section>

  <!-- SECTION 4: PROJECTS SHOWCASE -->
  <section id="projects">
    <h2 class="section-title reveal">Misi <span>Selesai</span></h2>
    <div class="projects-grid">
      <!-- Project 1 -->
      <div class="project-card reveal">
        <div class="project-img"><i class="fa-solid fa-cart-shopping"></i></div>
        <div class="project-info">
          <h3 class="project-title">E-Commerce Cyber App</h3>
          <p class="project-desc">Platform belanja daring dengan tema futuristik dan integrasi pembayaran langsung.</p>
          <div class="project-tags">
            <span class="tag">React</span>
            <span class="tag">Node.js</span>
            <span class="tag">Tailwind</span>
          </div>
          <a href="#" class="btn" style="padding: 6px 16px; font-size: 0.85rem;">Detail Proyek</a>
        </div>
      </div>
      <!-- Project 2 -->
      <div class="project-card reveal">
        <div class="project-img"><i class="fa-solid fa-chart-line"></i></div>
        <div class="project-info">
          <h3 class="project-title">SaaS Dashboard Admin</h3>
          <p class="project-desc">Antarmuka analitik data secara real-time dengan tampilan visual grafik modern.</p>
          <div class="project-tags">
            <span class="tag">Vue.js</span>
            <span class="tag">Chart.js</span>
            <span class="tag">Express</span>
          </div>
          <a href="#" class="btn" style="padding: 6px 16px; font-size: 0.85rem;">Detail Proyek</a>
        </div>
      </div>
      <!-- Project 3 -->
      <div class="project-card reveal">
        <div class="project-img"><i class="fa-solid fa-mobile-screen"></i></div>
        <div class="project-info">
          <h3 class="project-title">Fitness Tracker App</h3>
          <p class="project-desc">Aplikasi pelacak kebugaran dan jurnal latihan harian dengan elemen gamifikasi.</p>
          <div class="project-tags">
            <span class="tag">UI/UX</span>
            <span class="tag">Figma</span>
            <span class="tag">Mobile</span>
          </div>
          <a href="#" class="btn" style="padding: 6px 16px; font-size: 0.85rem;">Detail Proyek</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: CONTACT -->
  <section id="contact">
    <h2 class="section-title reveal">Kirim <span>Pesan</span></h2>
    <div class="contact-container reveal">
      <form id="contactForm">
        <div class="form-group">
          <label for="name">Nama / Instansi</label>
          <input type="text" id="name" placeholder="Masukkan nama kamu" required>
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" placeholder="email@contoh.com" required>
        </div>
        <div class="form-group">
          <label for="message">Pesan / Penawaran Misi</label>
          <textarea id="message" rows="5" placeholder="Tuliskan pesanmu di sini..." required></textarea>
        </div>
        <button type="submit" class="btn" style="width: 100%;">Kirim Pesan <i class="fa-solid fa-paper-plane"></i></button>
      </form>
    </div>
  </section>

  <!-- JAVASCRIPT FOR INTERACTIVITY & SCROLL REVEAL -->
  <script>
    // 1. Scroll Reveal Effect (Mengubah opacity & posisi elemen saat di-scroll)
    window.addEventListener('scroll', revealOnScroll);

    function revealOnScroll() {
      const reveals = document.querySelectorAll('.reveal');
      const windowHeight = window.innerHeight;

      reveals.forEach(element => {
        const revealTop = element.getBoundingClientRect().top;
        const revealPoint = 100; // Jarak pemicu animasi dari bawah layar

        if (revealTop < windowHeight - revealPoint) {
          element.classList.add('active');
        }
      });
    }

    // Jalankan sekali saat halaman pertama kali dimuat
    revealOnScroll();

    // 2. Simple Form Submit Handling
    document.getElementById('contactForm').addEventListener('submit', function(e) {
      e.preventDefault();
      alert('Pesanmu telah terkirim! Terima kasih telah menghubungi.');
      this.reset();
    });
  </script>
</body>
</html>
